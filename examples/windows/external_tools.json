    "title": "(kepub)",
    "hint": "fb2cng (fbc.exe): https://github.com/rupor-github/fb2cng/releases",
    "ext": "kepub.epub",
    "cmd": "powershell -NoProfile -Command \"Copy-Item '${HASHFILE}.raw' '${HASHFILE}.fb2'; & '${EXTDIR}/../tools/fbc.exe' convert --to kepub --nodirs --overwrite -o '${RESULTFILE}' '${HASHFILE}.fb2'; Remove-Item -Force '${HASHFILE}.fb2'\"",
    "debug": true,
    "type": "download"
  },
    "epub": {
    "active": true,
