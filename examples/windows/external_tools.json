    "cmd": "powershell -NoProfile -Command \"Copy-Item '${HASHFILE}.raw' '${HASHFILE}.fb2'; & '${EXTDIR}/../tools/fbc.exe' convert --to epub2 --nodirs --overwrite -o '${RESULTFILE}' '${HASHFILE}.fb2'; Remove-Item -Force '${HASHFILE}.fb2'\"",
    "cmdExport": "powershell -NoProfile -Command \"New-Item -ItemType Directory -Force -Path '${EXTDIR}/export' | Out-Null; Copy-Item '${RESULTFILE}' '${EXTDIR}/export/${FILENAME}'\"",
